# Exclude all node_modules since we're bundling
node_modules
node_modules/**

# Exclude source TypeScript files and maps
src/**/*.ts
src/**/*.map
src/**/*.test.*
src/**/*.spec.*
src/test/**

# Only include built webview assets and used images
!src/images/extension_logo.png
!src/images/agxLabs_logov2.png
!src/ApexLogPanel/ApexLogPanel.html
!src/ApexLogPanel/ApexLogPanel.css
!src/ApexLogPanel/ApexLogPanel.js
!src/ApexLogDetails/ApexLogDetails.html
!src/ApexLogDetails/ApexLogDetails.css
!src/ApexLogDetails/ApexLogDetails.js
!syntaxes/salesforce-apex-log.tmLanguage.json

# Exclude VS Code and git config
.vscode
.git
.gitignore

# Exclude build/test/config files
out/test
out/**/*.map
tsconfig.json
package-lock.json
*.yml
*.yaml
vitest.config.ts
eslint.config.mjs
*.eslintrc*
*.prettierrc*
esbuild.js
*.vsix

# Exclude OS-specific files
*.log
.DS_Store
Thumbs.db
