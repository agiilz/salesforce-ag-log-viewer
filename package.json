{
  "name": "salesforce-ag-log-viewer",
  "displayName": "Salesforce Logs",
  "description": "View and manage Salesforce developer logs with auto-refresh and filtering capabilities",
  "version": "1.2.5",
  "publisher": "aGxLabs",
  "author": {
    "name": "Adrià Gil"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agiilz/salesforce-ag-log-viewer"
  },
  "license": "CC-BY-NC-4.0",
  "keywords": [
    "salesforce",
    "apex",
    "logs",
    "debugging",
    "development"
  ],
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=20.0.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "src/images/extension_logo.png",
  "contributes": {
    "languages": [
      {
        "id": "salesforce-apex-log",
        "aliases": [
          "Salesforce Apex Log"
        ],
        "filenamePatterns": [
          "*_07L*.log"
        ]
      }
    ],
    "grammars": [
      {
        "language": "salesforce-apex-log",
        "scopeName": "source.salesforce-apex-log",
        "path": "./syntaxes/salesforce-apex-log.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Salesforce AG Log Viewer",
      "properties": {
        "salesforceAgLogViewer.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh logs at the configured interval"
        },
        "salesforceAgLogViewer.refreshInterval": {
          "type": "number",
          "minimum": 1000,
          "default": 5000,
          "description": "Interval in milliseconds between automatic log refreshes (minimum 1000ms)"
        },
        "salesforceAgLogViewer.currentUserOnly": {
          "type": "boolean",
          "default": true,
          "description": "Show logs only for the current user"
        },
        "salesforceAgLogViewer.traceFlagExpirationInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Expiration interval (in minutes) for Salesforce trace flags. Minimum: 5, Default: 15."
        },
        "salesforceAgLogViewer.showOutputOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Show the Salesforce AG Log Viewer output channel when the extension starts"
        },
        "salesforceAgLogViewer.largeLogWarningMb": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Ask before downloading logs at or above this size in MB"
        },
        "salesforceAgLogViewer.cacheMaxFiles": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Maximum number of downloaded logs retained in the workspace cache"
        },
        "salesforceAgLogViewer.cacheRetentionDays": {
          "type": "number",
          "default": 14,
          "minimum": 1,
          "description": "Maximum age in days for downloaded logs in the workspace cache"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "salesforce-ag-log-viewer",
          "title": "Salesforce Logs",
          "icon": "$(database)"
        }
      ]
    },
    "views": {
      "salesforce-ag-log-viewer": [
        {
          "type": "webview",
          "id": "salesforceLogsView",
          "name": "Salesforce Logs",
          "contextualTitle": "Salesforce Logs"
        }
      ]
    },
    "commands": [
      {
        "command": "salesforce-ag-log-viewer.refreshLogs",
        "title": "Refresh Logs",
        "icon": "$(refresh)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.toggleCurrentUserOnly",
        "title": "Log Visibility",
        "icon": "$(person)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.deleteAllLogs",
        "title": "Delete All Logs",
        "icon": "$(trash)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.showOptions",
        "title": "Show Options",
        "icon": "$(gear)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.showSearchBox",
        "title": "Search Logs",
        "icon": "$(search)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.toggleAutoRefresh",
        "title": "Toggle Auto Refresh",
        "icon": "$(sync)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.clearDownloadedLogs",
        "title": "Clear Downloaded Logs",
        "icon": "$(clear-all)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.setTraceFlagForUser",
        "title": "Set TraceFlag for User",
        "icon": "$(flag)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.deleteAllTraceFlagsExceptCurrent",
        "title": "Delete Expired Trace Flags (Except Current User)",
        "icon": "$(circle-slash)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.showLogDetails",
        "title": "Log Details",
        "icon": "$(list-flat)",
        "category": "Salesforce AG Log Viewer"
      },
      {
        "command": "salesforce-ag-log-viewer.exportFilteredLogs",
        "title": "Export Filtered Logs to CSV",
        "icon": "$(export)",
        "category": "Salesforce AG Log Viewer"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "salesforce-ag-log-viewer.showSearchBox",
          "when": "view == salesforceLogsView",
          "group": "navigation@1"
        },
        {
          "command": "salesforce-ag-log-viewer.refreshLogs",
          "when": "view == salesforceLogsView",
          "group": "navigation@2"
        },
        {
          "command": "salesforce-ag-log-viewer.toggleCurrentUserOnly",
          "when": "view == salesforceLogsView",
          "group": "navigation@3"
        },
        {
          "command": "salesforce-ag-log-viewer.setTraceFlagForUser",
          "when": "view == salesforceLogsView",
          "group": "navigation@4"
        },
        {
          "command": "salesforce-ag-log-viewer.deleteAllTraceFlagsExceptCurrent",
          "when": "view == salesforceLogsView",
          "group": "navigation@5"
        },
        {
          "command": "salesforce-ag-log-viewer.clearDownloadedLogs",
          "when": "view == salesforceLogsView",
          "group": "navigation@6"
        },
        {
          "command": "salesforce-ag-log-viewer.deleteAllLogs",
          "when": "view == salesforceLogsView",
          "group": "navigation@7"
        },
        {
          "command": "salesforce-ag-log-viewer.showOptions",
          "when": "view == salesforceLogsView",
          "group": "navigation@8"
        }
      ],
      "editor/title": [
        {
          "command": "salesforce-ag-log-viewer.showLogDetails",
          "title": "Log Details",
          "icon": "$(list-flat)",
          "when": "resourceLangId =~ /log/ || resourceExtname =~ /\\.log/ || resourceFilename =~ /.*07LJW.*/ || resourceFilename =~ /.*\\d{2}-\\d{2}-\\d{4}_\\d{2}-\\d{2}.*/",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test",
    "package:check": "npm run check && vsce package --no-dependencies --out salesforce-ag-log-viewer.vsix"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "20.x",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.4",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fs-extra": "^11.3.0",
    "jsforce": "^3.8.2"
  }
}